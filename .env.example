[TEMPLATE]
# FloraNet Environment Variables Example — 100% open-source stack

# ==========================================
# Local LLM Gateway (Ollama — Apache-2.0)
# ==========================================
# The OpenAI-compatible endpoint Ollama exposes. Docker Compose uses the
# service name "ollama"; bare-metal defaults to localhost.
OLLAMA_BASE_URL="http://localhost:11434/v1"

# Model picks (all open weights — tune to your hardware):
#   Low-RAM laptops / judges:  gemma3:4b        (~3 GB)
#   Balanced:                  qwen2.5vl:7b     (~6 GB, vision)
#   Max quality + GPU:         qwen2.5vl:32b
OLLAMA_TEXT_MODEL="gemma3:4b"
OLLAMA_VISION_MODEL="gemma3:4b"
# Tool-calling agent model — must be tool-trained (Gemma 3 is NOT; use
# Qwen 2.5 / Llama 3.1 class for the Agro-Agent endpoint)
OLLAMA_AGENT_MODEL="qwen2.5:3b"
# Max autonomous tool-call rounds per agent request
AGENT_MAX_STEPS="6"
# Seconds to wait for local generation (7B CPU models can take a while)
OLLAMA_TIMEOUT_SECONDS="120"

# Local multilingual embedding model (sentence-transformers, Apache-2.0)
EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# ==========================================
# Backend Configuration
# ==========================================

# Broker URLs (docker-compose injects these automatically)
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# CORS
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ==========================================
# Frontend Configuration
# ==========================================
NEXT_PUBLIC_API_URL="http://localhost:7880"
